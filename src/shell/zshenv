# Ronnie shell integration (generated, overwritten at each start): zsh reads its startup files from
# here, each one loads the user's own file, and .zshrc finally gives this terminal its own history.
RONNIE_ZDOTDIR=$ZDOTDIR
ZDOTDIR=${RONNIE_USER_ZDOTDIR:-$HOME}
[[ -r $ZDOTDIR/.zshenv ]] && source $ZDOTDIR/.zshenv
# The user's .zshenv may have moved ZDOTDIR.
RONNIE_USER_ZDOTDIR=$ZDOTDIR
[[ -o interactive || -o login ]] && ZDOTDIR=$RONNIE_ZDOTDIR
