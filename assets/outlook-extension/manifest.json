{
  "manifest_version": 3,
  "name": "Ronnie — Claude pour Outlook",
  "description": "Un bouton Claude dans l'éditeur de mail d'Outlook : reformule le brouillon par Ronnie, sans jamais rien envoyer.",
  "version": "1.0.0",
  "key": "",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ]
    }
  ]
}
